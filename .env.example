NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=
ANTHROPIC_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=        # e.g. Revaltus <onboarding@revaltus.com> — domain must be verified in Resend
CRON_SECRET=
SERPER_API_KEY=
ADMIN_EMAIL=
# QA Desk rollout switch: off|shadow|on (default shadow when unset/empty).
#   shadow → QA specialists run and report only; the legacy critic still runs.
#   on     → QA applies auto findings, replaces the legacy critic, and gates
#            phase 5→6 + the content-ready email until QA is terminal.
CONTENT_QA_MODE=on
# Pexels API key for stock-photo sourcing during deliverable assembly.
# Free tier: 200 requests/hour. Sign up at https://www.pexels.com/api/new/
# If missing or empty, the builder skips stock-photo fetching and falls back
# to colored SVG placeholders for hero images.
PEXELS_API_KEY=

# ---- GitHub App for the in-admin content editor ----
# Required to edit a published client's content in their Phase II site repo.
# Create a GitHub App under the CountingFive org with Contents: Read & Write,
# install it on the org, then fill these in.
#   GITHUB_APP_ID                 → App's numeric ID (from the App settings page)
#   GITHUB_APP_PRIVATE_KEY        → Private key PEM. Either paste the multiline
#                                   PEM directly, or paste a single line with
#                                   literal "\n" between rows (we'll expand).
#   GITHUB_APP_INSTALLATION_ID    → Installation ID (visible in the App's
#                                   installation URL: .../installations/{ID})
#   GITHUB_ORG                    → GitHub org slug, e.g. "Revaltus"
#   GITHUB_TEMPLATE_REPO          → Optional. Repo the "Seed from template"
#                                   action copies from. Defaults to
#                                   "Revaltus/CountingFiveTemplate".
#                                   Accepts "name" or "owner/name".
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_ORG=
GITHUB_TEMPLATE_REPO=

# ---- WordPress blog-sync bridge (optional, transition-only) ----
# One-way feed that lets self-hosted WordPress sites pull published blog posts
# from a client's git repo. Sites + their bearer secrets are managed entirely in
# the app UI (Admin → WordPress Sites); no env vars are needed. The feed builds
# absolute image-proxy URLs from NEXT_PUBLIC_APP_URL (set above), so ensure that
# is your public app origin in production.

# ---- Site Audit feature (all optional) ----
# PAGESPEED_API_KEY → raises Google PageSpeed Insights rate limits. The audit
#   works without it (basic PSI use needs no key) but may be throttled.
# (The `site:` index check reuses SERPER_API_KEY above; degrades to
#  "unverified" when that key is missing.)
PAGESPEED_API_KEY=
# GOOGLE_PLACES_API_KEY → authoritative Google Business Profile data (rating,
#   review count, categories, hours) for the audit's Social & Local Presence
#   pass, via the Places API (New) Text Search. Server-only — never expose it
#   client-side. Without it the pass degrades to Serper discovery (presence
#   only). Enable "Places API (New)" in Google Cloud and create an API key.
GOOGLE_PLACES_API_KEY=
# SCRAPINGBEE_API_KEY → stealth-proxy fallback for the crawler. When a site's bot
#   protection (Cloudflare/WAF) blocks a direct fetch from our server IP with a
#   401/403/429/503, the crawl retries that site through ScrapingBee's residential
#   stealth proxy (capped pages to bound credit spend). Without it, bot-protected
#   sites fail the crawl with a clear "bot protection blocked our crawler" message.
#   Server-only. Get a key at scrapingbee.com.
SCRAPINGBEE_API_KEY=

# Design Studio renderer (local dev only). Point at a local Chrome/Chromium; on
# Vercel the renderer uses @sparticuz/chromium automatically.
# macOS: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHROMIUM_EXECUTABLE_PATH=

# Vercel team slug (e.g. "revaltus") — builds the editor's draft-preview URL.
NEXT_PUBLIC_VERCEL_TEAM_SLUG=
# Vercel → Project → Settings → Deployment Protection → Protection Bypass for
# Automation. Lets Design Studio's self-triggered run steps reach protected URLs.
VERCEL_AUTOMATION_BYPASS_SECRET=
